[runtime]
workspace = "~/.akashic/workspace"

[llm]
registry = "workspace"

[agent]
system_prompt = "You are Akashic, a helpful AI assistant with access to tools. Always respond in the same language the user uses."
max_tokens = 8192
max_iterations = 0
dev_mode = true

[agent.context]

[agent.context.compaction]
keep_recent_tokens = 20000
[agent.tools]
search_enabled = true

[agent.wiring]
toolsets = ["meta_common", "spawn", "schedule"]

[channels.telegram]
token = "8131244814:AAEKQM44YozyY3emecbcOlPENiTEqxJbQuU"
allow_from = ["huashen258"]

[channels.qq]
enabled = true
bot_uin = "1666567690"
allow_from = ["2494946808"]

[[channels.qq.groups]]
group_id = "1055657247"
allow_from = ["2494946808"]
require_at = true

[[channels.qq.groups]]
group_id = "970314561"
allow_from = ["2494946808"]
require_at = true

[[channels.qq.groups]]
group_id = "809444966"
allow_from = ["2494946808", "1310146443"]
require_at = true

[[channels.qq.groups]]
group_id = "1101982414"
allow_from = ["2494946808"]
require_at = true

[[channels.qq.groups]]
group_id = "1071026675"
allow_from = ["2494946808"]
