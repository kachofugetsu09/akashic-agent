[memory]
enabled = true
engine = "akasha"

[memory.embedding]
model = "text-embedding-v4"
api_key = "sk-a5ecd182e2644ec98afea95fa964b47e"
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

[proactive]
enabled = true
profile = "daily"
lifecycle = "wake"

[proactive.target]
channel = "mobile"

chat_id = "b2b817df-2d23-4a8f-af01-415f4faf0f9b"

[proactive.agent]
max_steps = 20
content_limit = 5
web_fetch_max_chars = 8000
context_prob = 0.03
delivery_cooldown_hours = 0

[mobile_realtime]
enabled = true
host = "0.0.0.0"
port = 6323
database = "data/mobile_realtime.db"
lan_hostname = "192.168.0.108"
public_url = "wss://mobile.wangyuanzhe28.site/ws"
max_attachment_mb = 50
inbox_retention_days = 7

[mobile_realtime.key_encryption]
provider = "secret_service"
master_key_namespace = "akasic/mobile-realtime"
keyset_manifest = "data/mobile/keys/current.json"

[proactive.drift]
enabled = true
max_steps = 30
min_interval_hours = 2
