{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@akashic/web-ui-v1": ["packages/akashic-web-ui-v1/index.d.ts"],
      "@akashic/workbench-ui-v2": ["packages/akashic-workbench-ui-v2/index.d.ts"],
      "@/*": ["frontend/chat/src/*"]
    },
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["frontend/dashboard/src/**/*.ts", "frontend/dashboard/src/**/*.tsx", "frontend/chat/src/**/*.ts", "frontend/chat/src/**/*.tsx", "frontend/theme/src/**/*.ts", "plugins/**/*.ts", "plugins/**/*.tsx", "packages/**/*.d.ts", "types/**/*.d.ts"]
}
