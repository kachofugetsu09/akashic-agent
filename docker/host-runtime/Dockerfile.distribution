ARG AKASHIC_BASE_IMAGE=archlinux@sha256:345a872f6c95e082d4b8c050af637eebb57402c6e2177b411c3acf7df84eb33b
FROM ${AKASHIC_BASE_IMAGE}

ARG AKASHIC_BASE_IMAGE
ARG AKASHIC_RUNTIME_UID=1000
ARG AKASHIC_RUNTIME_GID=1000
ARG AKASHIC_ARCH_SNAPSHOT=2026/08/09
ARG AKASHIC_PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG AKASHIC_SOURCE_COMMIT
ARG AKASHIC_SOURCE_TREE
ARG AKASHIC_CORE_SHA256

ENV HOME=/home/huashen \
    PATH=/opt/venv/bin:/home/huashen/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AKASHIC_DISTRIBUTION=/opt/akashic/distribution

RUN printf '%s\n' \
        'CacheServer = https://mirrors.tuna.tsinghua.edu.cn/archlinux/$repo/os/$arch' \
        'CacheServer = https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch' \
        "Server = https://archive.archlinux.org/repos/${AKASHIC_ARCH_SNAPSHOT}/\$repo/os/\$arch" \
        > /etc/pacman.d/mirrorlist \
    && pacman --disable-download-timeout -Syyu --noconfirm \
    && pacman --disable-download-timeout -S --noconfirm --needed \
        ca-certificates \
        curl \
        git \
        python \
        python-pip \
        util-linux \
        zsh \
    && pacman -Scc --noconfirm \
    && groupadd --gid "${AKASHIC_RUNTIME_GID}" huashen \
    && useradd \
        --uid "${AKASHIC_RUNTIME_UID}" \
        --gid "${AKASHIC_RUNTIME_GID}" \
        --create-home \
        --shell /usr/bin/zsh \
        huashen

WORKDIR /opt/akashic

# The only source material copied into this image is the generated Core tar.
COPY core.tar /tmp/akashic-core.tar
COPY distribution.json /opt/akashic/distribution/distribution.json
COPY profiles /opt/akashic/distribution/profiles
COPY *.bundle /opt/akashic/distribution/
COPY distribution-entrypoint.sh /opt/akashic/distribution-entrypoint.sh

RUN test -n "${AKASHIC_SOURCE_COMMIT}" \
    && test -n "${AKASHIC_SOURCE_TREE}" \
    && test -n "${AKASHIC_CORE_SHA256}" \
    && test "$(sha256sum /tmp/akashic-core.tar | cut -d' ' -f1)" = "${AKASHIC_CORE_SHA256}" \
    && mkdir -p /opt/akashic/source \
    && tar -xf /tmp/akashic-core.tar -C /opt/akashic/source \
    && test ! -e /opt/akashic/source/plugins \
    && test -f /opt/akashic/source/config.example.toml \
    && test -f /opt/akashic/source/docker/host-runtime/requirements.lock

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install \
        --index-url "${AKASHIC_PYPI_INDEX_URL}" \
        --no-cache-dir --require-hashes \
        -r /opt/akashic/source/docker/host-runtime/requirements.lock \
    && /opt/venv/bin/python -c "import site; from pathlib import Path; Path(site.getsitepackages()[0], 'akashic-sdk.pth').write_text('/opt/akashic/source/sdk/python/src\\n')" \
    && /opt/venv/bin/python -c "import akashic_sdk; assert akashic_sdk.__file__.startswith('/opt/akashic/source/sdk/python/src/')"

RUN mkdir -p /tmp/akashic-distribution-workspace /tmp/akashic-distribution-plugins \
    && /opt/venv/bin/python /opt/akashic/source/scripts/install_plugin_distribution.py \
        --distribution /opt/akashic/distribution \
        --profile /opt/akashic/distribution/profiles/default.json \
        --workspace /tmp/akashic-distribution-workspace \
        --plugins-home /tmp/akashic-distribution-plugins \
        --verify-only \
    && /opt/venv/bin/python /opt/akashic/source/scripts/distribution_runtime.py write \
        --distribution /opt/akashic/distribution \
        --output /opt/akashic/runtime-info.json \
        --source-commit "${AKASHIC_SOURCE_COMMIT}" \
        --source-tree "${AKASHIC_SOURCE_TREE}" \
        --core-sha256 "${AKASHIC_CORE_SHA256}" \
        --base-image "${AKASHIC_BASE_IMAGE}" \
        --arch-snapshot "${AKASHIC_ARCH_SNAPSHOT}" \
        --pypi-index-url "${AKASHIC_PYPI_INDEX_URL}" \
    && rm -rf /tmp/akashic-core.tar /tmp/akashic-distribution-workspace /tmp/akashic-distribution-plugins \
    && chown -R root:root /opt/akashic \
    && chmod -R a-w /opt/akashic \
    && chmod 0555 /opt/akashic/distribution-entrypoint.sh

LABEL org.opencontainers.image.revision="${AKASHIC_SOURCE_COMMIT}"

USER huashen:huashen
ENTRYPOINT ["/opt/akashic/distribution-entrypoint.sh"]
CMD ["supervise"]
