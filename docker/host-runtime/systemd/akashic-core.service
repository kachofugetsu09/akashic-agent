[Unit]
Description=Akashic Core container
Requires=akashic-host-bridge.service akashic-home-services.service
Requires=docker.service
After=docker.service akashic-host-bridge.service akashic-home-services.service
PartOf=akashic-host-bridge.service akashic-home-services.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=huashen
Group=huashen
SupplementaryGroups=docker
EnvironmentFile=%h/.config/akashic-container/runtime.env
ExecStartPre=/usr/bin/env ${AKASHIC_BRIDGE_PYTHON} ${AKASHIC_RUNTIME_CHECKOUT}/scripts/verify_host_runtime_deployment.py --release-manifest ${AKASHIC_RELEASE_MANIFEST} --image ${AKASHIC_IMAGE}
ExecStart=/usr/bin/docker compose --project-name akashic-core --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.experiment.yaml --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.home-services.yaml up --no-color --abort-on-container-exit --exit-code-from akashic-core
ExecStop=/usr/bin/docker compose --project-name akashic-core --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.experiment.yaml --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.home-services.yaml stop --timeout 60
ExecStopPost=/usr/bin/docker compose --project-name akashic-core --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.experiment.yaml --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.home-services.yaml down --remove-orphans
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
