[Unit]
Description=Akashic Core container
Requires=akashic-host-bridge.service
Requires=docker.service
Wants=akashic-home-services.service
After=docker.service akashic-host-bridge.service akashic-home-services.service
PartOf=akashic-host-bridge.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=huashen
Group=huashen
SupplementaryGroups=docker
EnvironmentFile=%h/.config/akashic-container/runtime.env
# 宿主工具链由 Requires/PartOf 的 Host Bridge 启动前核对；这里只核对镜像身份。
ExecStartPre=/usr/bin/env ${AKASHIC_BRIDGE_PYTHON} ${AKASHIC_RUNTIME_CHECKOUT}/scripts/verify_host_runtime_deployment.py --image-only --release-manifest ${AKASHIC_RELEASE_MANIFEST} --image ${AKASHIC_IMAGE}
ExecStart=/usr/bin/docker compose --project-name akashic-core --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.experiment.yaml --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.external-services.yaml up --no-color --abort-on-container-exit --exit-code-from akashic-core akashic-core workload-controller
ExecStop=/usr/bin/docker compose --project-name akashic-core --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.experiment.yaml --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/host-runtime/compose.external-services.yaml stop --timeout 60 akashic-core workload-controller
# Compose 收尾也属于正常退出；不要在容器已停止后立即向它发送第二次信号。
ExecStop=/bin/sh -c 'test -z "$$MAINPID" || exec /usr/bin/tail --pid="$$MAINPID" -f /dev/null'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
