# This file is copied to ~/.config/akashic-container/runtime.env with mode 0600.
# Every path and digest belongs to one approved release generation.
AKASHIC_BRIDGE_PYTHON=/srv/data/services/akashic/bridge-venvs/COMMIT/bin/python
AKASHIC_MISE=/home/huashen/.local/bin/mise
AKASHIC_RUNTIME_CHECKOUT=/srv/data/services/akashic/runtime-sources/COMMIT
AKASHIC_RUNTIME_COMMIT=FULL_40_CHARACTER_COMMIT
AKASHIC_HOST_TOOLCHAIN_DIGEST=FULL_64_CHARACTER_SHA256
AKASHIC_RELEASE_MANIFEST=/srv/data/services/akashic/releases/COMMIT.json
AKASHIC_IMAGE=sha256:FULL_64_CHARACTER_IMAGE_ID
AKASHIC_HOST_BRIDGE_SOCKET=/srv/data/services/akashic/run/host-bridge.sock
AKASHIC_HOST_BRIDGE_TOKEN_FILE=/srv/data/services/akashic/secrets/host-bridge.token
AKASHIC_HOST_BRIDGE_TOKEN=REDACTED_BOOT_CAPABILITY
AKASHIC_HOST_BRIDGE_DIR=/srv/data/services/akashic/run
AKASHIC_HOST_ARTIFACT_ROOT=/srv/data/services/akashic/runtime/host-executions
AKASHIC_CONFIG=/srv/data/services/akashic/state/config.toml
AKASHIC_WORKSPACE=/srv/data/services/akashic/state/workspace
AKASHIC_PLUGIN_HOME=/srv/data/services/akashic/state/plugin-home
AKASHIC_EXPERIMENT_ROOT=/srv/data/services/akashic/state
AKASHIC_WORKLOAD_RUNTIME_DIR=/srv/data/services/akashic/state/workload-runtime
AKASHIC_CONTAINER_NAME=akashic-core
AKASHIC_WEB_BIND_ADDRESS=127.0.0.1
AKASHIC_PUBLISHED_WEB_PORT=2236
AKASHIC_PUBLISHED_MOBILE_PORT=6323
AKASHIC_SERVICES_NETWORK=akashic-services
AKASHIC_WORKLOAD_NETWORK=akashic-workloads
AKASHIC_UID=1000
AKASHIC_GID=1000
AKASHIC_DOCKER_GID=961
AKASHIC_ENVIRONMENT=hua-home
AKASHIC_LOG_LEVEL=INFO
TZ=Asia/Shanghai
OPENCODE_GO_API_KEY=REDACTED_RUNTIME_SECRET
