[Unit]
Description=Akashic persistent OpenCLI browser
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=huashen
Group=huashen
SupplementaryGroups=docker
EnvironmentFile=%h/.config/akashic-container/runtime.env
EnvironmentFile=%h/.config/akashic-container/home-services.env
ExecStartPre=/usr/bin/install -d -m 0700 ${OPENCLI_BROWSER_CONFIG}
ExecStartPre=/usr/bin/test -d ${OPENCLI_EXTENSION_DIR}
ExecStartPre=/usr/bin/docker compose --project-name akashic-opencli-browser --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/home-services/compose.opencli.yaml config --quiet
ExecStartPre=/usr/bin/docker compose --project-name akashic-opencli-browser --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/home-services/compose.opencli.yaml up --detach --wait --wait-timeout 180
ExecStart=/usr/bin/docker compose --project-name akashic-opencli-browser --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/home-services/compose.opencli.yaml up --no-color --no-recreate --abort-on-container-exit
ExecStop=/usr/bin/docker compose --project-name akashic-opencli-browser --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/home-services/compose.opencli.yaml stop --timeout 60
ExecStopPost=/usr/bin/docker compose --project-name akashic-opencli-browser --file ${AKASHIC_RUNTIME_CHECKOUT}/docker/home-services/compose.opencli.yaml down --remove-orphans
Restart=always
RestartSec=5s
TimeoutStartSec=240s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
