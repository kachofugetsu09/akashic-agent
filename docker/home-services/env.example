RSSHUB_IMAGE=diygod/rsshub@sha256:replace-me
REDIS_IMAGE=redis@sha256:replace-me
BROWSERLESS_IMAGE=browserless/chrome@sha256:replace-me
REAL_BROWSER_IMAGE=ghcr.io/hyoban/puppeteer-real-browser-hono@sha256:replace-me
OPENCLI_BROWSER_IMAGE=jlesage/chromium@sha256:replace-me
RSSHUB_ENV_FILE=/srv/akashic/home-services/rsshub.env
RSSHUB_REDIS_DATA=/srv/akashic/home-services/rsshub-redis
OPENCLI_BROWSER_CONFIG=/srv/akashic/home-services/opencli-browser
OPENCLI_EXTENSION_DIR=/srv/akashic/home-services/opencli-extension
AKASHIC_SERVICES_NETWORK=akashic-services
RSSHUB_PUBLISHED_PORT=1200
OPENCLI_BROWSER_WEB_PORT=5800
